generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum NotePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ShiftNoteStatus {
  TO_DO
  IN_PROGRESS
  DONE
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  INSPECTED
  OUT_OF_ORDER
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  TRIPLE
  QUADRUPLE
}

enum RoomView {
  GAVE
  PYRENEES
  COUR_INTERIEURE
}

model Hotel {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  rooms   Room[]
  notes   ShiftNote[]
  tickets Ticket[]
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  users       User[]
}

model User {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  hotelId      String
  roleId       String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  hotel          Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  role           Role               @relation(fields: [roleId], references: [id])
  notes          ShiftNote[]
  noteComments   ShiftNoteComment[]
  createdTickets Ticket[]           @relation("TicketCreator")
}

model Room {
  id             String     @id @default(cuid())
  number         String
  floor          Int
  building       String
  type           RoomType   @default(DOUBLE)
  view           RoomView?
  capacity       Int        @default(2)
  status         RoomStatus @default(AVAILABLE)
  guestName      String?
  groupName      String?
  arrivalDate    DateTime?
  departureDate  DateTime?
  housekeeper    String?
  lastInspectedAt DateTime?
  hotelId        String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  hotel   Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([hotelId, number])
  @@index([hotelId, building, floor])
  @@index([hotelId, status])
}

model ShiftNote {
  id        String          @id @default(cuid())
  title     String
  content   String
  priority  NotePriority    @default(NORMAL)
  status    ShiftNoteStatus @default(TO_DO)
  category  String
  service   String
  pinned    Boolean         @default(false)
  hotelId   String
  authorId  String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  hotel    Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  author   User               @relation(fields: [authorId], references: [id])
  comments ShiftNoteComment[]

  @@index([hotelId, createdAt])
  @@index([hotelId, priority, status])
}

model ShiftNoteComment {
  id        String   @id @default(cuid())
  content   String
  noteId    String
  authorId  String
  createdAt DateTime @default(now())

  note   ShiftNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author User      @relation(fields: [authorId], references: [id])

  @@index([noteId, createdAt])
}

model Ticket {
  id          String       @id @default(cuid())
  reference   String       @unique
  title       String
  description String
  priority    NotePriority @default(NORMAL)
  status      TicketStatus @default(NEW)
  service     String
  hotelId     String
  roomId      String?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  closedAt    DateTime?

  hotel     Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room      Room? @relation(fields: [roomId], references: [id])
  createdBy User  @relation("TicketCreator", fields: [createdById], references: [id])
}
