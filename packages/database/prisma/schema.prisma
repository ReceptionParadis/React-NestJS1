generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus { ACTIVE INACTIVE INVITED }
enum NotePriority { LOW NORMAL HIGH CRITICAL }
enum ShiftNoteStatus { TO_DO IN_PROGRESS DONE }
enum TicketStatus { NEW ASSIGNED IN_PROGRESS WAITING RESOLVED CLOSED }
enum RoomStatus { AVAILABLE OCCUPIED CLEANING INSPECTED OUT_OF_ORDER }
enum RoomType { SINGLE DOUBLE TWIN TRIPLE QUADRUPLE }
enum RoomView { GAVE PYRENEES COUR_INTERIEURE }
enum GroupStatus { PREPARATION CONFIRMED ACTION_REQUIRED IN_HOUSE COMPLETED CANCELLED }
enum GroupPaymentStatus { PENDING DEPOSIT_RECEIVED PAID OVERDUE }
enum RoomingEntryStatus { PENDING VALID ALLOCATED ERROR }

model Hotel {
  id String @id @default(cuid())
  name String
  slug String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  rooms Room[]
  notes ShiftNote[]
  tickets Ticket[]
  groups HotelGroup[]
}

model Role {
  id String @id @default(cuid())
  name String @unique
  description String?
  users User[]
}

model User {
  id String @id @default(cuid())
  firstName String
  lastName String
  email String @unique
  passwordHash String
  status UserStatus @default(ACTIVE)
  hotelId String
  roleId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])
  notes ShiftNote[]
  noteComments ShiftNoteComment[]
  createdTickets Ticket[] @relation("TicketCreator")
  assignedTickets Ticket[] @relation("TicketAssignee")
  ticketComments TicketComment[]
  ticketEvents TicketEvent[]
}

model Room {
  id String @id @default(cuid())
  number String
  floor Int
  building String
  type RoomType @default(DOUBLE)
  view RoomView?
  capacity Int @default(2)
  status RoomStatus @default(AVAILABLE)
  guestName String?
  groupName String?
  arrivalDate DateTime?
  departureDate DateTime?
  housekeeper String?
  lastInspectedAt DateTime?
  hotelId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  roomingEntries RoomingListEntry[]
  @@unique([hotelId, number])
  @@index([hotelId, building, floor])
  @@index([hotelId, status])
}

model ShiftNote {
  id String @id @default(cuid())
  title String
  content String
  priority NotePriority @default(NORMAL)
  status ShiftNoteStatus @default(TO_DO)
  category String
  service String
  pinned Boolean @default(false)
  hotelId String
  authorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
  comments ShiftNoteComment[]
  @@index([hotelId, createdAt])
  @@index([hotelId, priority, status])
}

model ShiftNoteComment {
  id String @id @default(cuid())
  content String
  noteId String
  authorId String
  createdAt DateTime @default(now())
  note ShiftNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
  @@index([noteId, createdAt])
}

model Ticket {
  id String @id @default(cuid())
  reference String @unique
  title String
  description String
  priority NotePriority @default(NORMAL)
  status TicketStatus @default(NEW)
  service String
  location String?
  hotelId String
  roomId String?
  createdById String
  assigneeId String?
  dueAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?
  closedAt DateTime?
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room Room? @relation(fields: [roomId], references: [id])
  createdBy User @relation("TicketCreator", fields: [createdById], references: [id])
  assignee User? @relation("TicketAssignee", fields: [assigneeId], references: [id])
  comments TicketComment[]
  events TicketEvent[]
  @@index([hotelId, status, priority])
  @@index([assigneeId, status])
  @@index([roomId])
}

model TicketComment {
  id String @id @default(cuid())
  content String
  ticketId String
  authorId String
  createdAt DateTime @default(now())
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
  @@index([ticketId, createdAt])
}

model TicketEvent {
  id String @id @default(cuid())
  type String
  message String
  ticketId String
  actorId String
  createdAt DateTime @default(now())
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])
  @@index([ticketId, createdAt])
}

model HotelGroup {
  id String @id @default(cuid())
  code String @unique
  name String
  agency String?
  dmc String?
  leaderName String?
  leaderPhone String?
  language String?
  arrivalDate DateTime
  departureDate DateTime
  arrivalTime String?
  dinnerTime String?
  pax Int
  roomCount Int
  buses Int @default(0)
  parkingReserved Boolean @default(false)
  status GroupStatus @default(PREPARATION)
  paymentStatus GroupPaymentStatus @default(PENDING)
  notes String?
  hotelId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomingList RoomingListEntry[]
  payments GroupPayment[]
  @@index([hotelId, arrivalDate])
  @@index([hotelId, status])
}

model RoomingListEntry {
  id String @id @default(cuid())
  groupId String
  firstName String
  lastName String
  gender String?
  birthDate DateTime?
  roomType RoomType
  requestedRoom String?
  roomId String?
  specialNeeds String?
  status RoomingEntryStatus @default(PENDING)
  sourceRow Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  group HotelGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  room Room? @relation(fields: [roomId], references: [id])
  @@index([groupId, status])
  @@index([roomId])
}

model GroupPayment {
  id String @id @default(cuid())
  groupId String
  label String
  amount Decimal @db.Decimal(12, 2)
  currency String @default("EUR")
  dueDate DateTime?
  paidAt DateTime?
  reference String?
  createdAt DateTime @default(now())
  group HotelGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@index([groupId, dueDate])
}
